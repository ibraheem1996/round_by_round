rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validWeight() {
        let weight = request.resource.data.bodyWeightKg;
        return weight is number && weight >= 40 && weight <= 150
          && weight * 2 == int(weight * 2);
      }

      allow get: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['bodyWeightKg'])
        && validWeight();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bodyWeightKg'])
        && validWeight();
    }
  }
}
